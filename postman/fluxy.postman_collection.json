                  "key": "from",
                  "value": "2026-01-01",
                  "description": "YYYY-MM-DD",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "description": "YYYY-MM-DD",
                  "disabled": true
                }
              ]
            },
            "description": "Totais de receita/despesa, saldo e quebra por categoria no período. Sem from/to, usa o período padrão do serviço."
          }
        }
      ]
    }
  ]
}
